# Local development only. Copy to .env and fill values. Never commit .env.

# Postgres (docker-compose). Placeholders — replace before use.
POSTGRES_PORT=5432
AMEND_OWNER_PASSWORD=
AMEND_APP_PASSWORD=

# Prisma CLI / migrations / seed (amend_owner, BYPASSRLS)
DATABASE_URL_MIGRATE=postgresql://amend_owner:REPLACE_ME@127.0.0.1:5432/amend

# Runtime queries (amend_app, RLS enforced)
DATABASE_URL=postgresql://amend_app:REPLACE_ME@127.0.0.1:5432/amend

# Auth.js cookie signing (32+ characters)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# 64-char hex (32 bytes) application-layer PII key
PII_ENCRYPTION_KEY=
# 64-char hex HMAC key for email lookup
EMAIL_LOOKUP_KEY=

# Seed accounts (min 12 characters). Not stored in git.
SEED_PASSWORD=
# Encrypted TOTP seed for superadmin@local / moderator@local (base32). Leave empty to skip MFA secrets in seed.
SEED_MFA_SECRET=

# Group alias for pending-registration alerts (no hostname hard-coded in code)
ADMIN_ALERT_EMAIL=

EMAIL_TRANSPORT=json
EMAIL_JSON_DIR=.tmp/mail
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# S3-compatible object storage (local MinIO; production DreamObjects via env only)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=amend-resources
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Optional clamd (docker compose --profile scan). Empty CLAMD_HOST uses the EICAR test double.
CLAMD_HOST=
CLAMD_PORT=3310

# Optional analytics. Unset → no-op (no PII).
POSTHOG_KEY=
