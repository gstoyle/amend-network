generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_MIGRATE")
}

enum ProgramRole {
  pathways
  lead
  none
}

enum AdminRole {
  super_admin
  admin
  moderator
  none
}

enum UserStatus {
  pending
  active
  deactivated
  denied
}

enum AuditSeverity {
  info
  warning
  security
}

enum JoinSource {
  self_registered
  invited
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

model Network {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  programRole ProgramRole  @map("program_role")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  users       User[]
  invitations Invitation[]

  @@map("networks")
}

model DocAffiliation {
  id        String   @id @default(uuid()) @db.Uuid
  label     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  @@map("doc_affiliations")
}

model User {
  id                        String               @id @default(uuid()) @db.Uuid
  emailLookup               Bytes                @unique @map("email_lookup")
  emailEncrypted            Bytes                @map("email_encrypted")
  passwordHash              String               @map("password_hash")
  firstNameEncrypted        Bytes?               @map("first_name_encrypted")
  lastNameEncrypted         Bytes?               @map("last_name_encrypted")
  titleEncrypted            Bytes?               @map("title_encrypted")
  docAffiliationIdEncrypted Bytes?               @map("doc_affiliation_id_encrypted")
  joinSource                JoinSource?          @map("join_source")
  registrationIp            String?              @map("registration_ip") @db.Inet
  denialReasonEncrypted     Bytes?               @map("denial_reason_encrypted")
  networkId                 String?              @map("network_id") @db.Uuid
  programRole               ProgramRole          @map("program_role")
  adminRole                 AdminRole            @map("admin_role")
  status                    UserStatus
  mfaSecretEncrypted        Bytes?               @map("mfa_secret_encrypted")
  mfaEnabled                    Boolean              @default(false) @map("mfa_enabled")
  directoryVisible              Boolean              @default(false) @map("directory_visible")
  directoryShowTitle            Boolean              @default(false) @map("directory_show_title")
  directoryShowDocAffiliation   Boolean              @default(false) @map("directory_show_doc_affiliation")
  directoryShowEmail            Boolean              @default(false) @map("directory_show_email")
  directoryPrivacySetAt         DateTime?            @map("directory_privacy_set_at") @db.Timestamptz(6)
  lastLoginAt                   DateTime?            @map("last_login_at") @db.Timestamptz(6)
  createdAt                     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  network                       Network?             @relation(fields: [networkId], references: [id])
  sessions                      Session[]
  passwordResetTokens           PasswordResetToken[]

  @@map("users")
}

model DirectoryListing {
  userId               String      @id @map("user_id") @db.Uuid
  programRole          ProgramRole @map("program_role")
  networkId            String      @map("network_id") @db.Uuid
  firstNameEncrypted   Bytes       @map("first_name_encrypted")
  lastNameEncrypted    Bytes       @map("last_name_encrypted")
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("directory_listings")
}

model DirectoryShownTitle {
  userId          String   @id @map("user_id") @db.Uuid
  titleEncrypted  Bytes    @map("title_encrypted")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("directory_shown_titles")
}

model DirectoryShownDoc {
  userId                      String   @id @map("user_id") @db.Uuid
  docAffiliationIdEncrypted   Bytes    @map("doc_affiliation_id_encrypted")
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("directory_shown_docs")
}

model DirectoryShownEmail {
  userId          String   @id @map("user_id") @db.Uuid
  emailEncrypted  Bytes    @map("email_encrypted")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("directory_shown_emails")
}

model DirectorySearchThrottle {
  userId           String   @id @map("user_id") @db.Uuid
  windowStartedAt  DateTime @map("window_started_at") @db.Timestamptz(6)
  searchCount      Int      @map("search_count")

  @@map("directory_search_throttle")
}

model Invitation {
  id                        String           @id @default(uuid()) @db.Uuid
  emailLookup               Bytes            @map("email_lookup")
  emailEncrypted            Bytes            @map("email_encrypted")
  tokenHash                 Bytes            @unique @map("token_hash")
  inviterId                 String           @map("inviter_id") @db.Uuid
  networkId                 String           @map("network_id") @db.Uuid
  firstNameEncrypted        Bytes            @map("first_name_encrypted")
  lastNameEncrypted         Bytes            @map("last_name_encrypted")
  titleEncrypted            Bytes?           @map("title_encrypted")
  docAffiliationIdEncrypted Bytes?           @map("doc_affiliation_id_encrypted")
  status                    InvitationStatus
  expiresAt                 DateTime         @map("expires_at") @db.Timestamptz(6)
  expiryReminderSentAt      DateTime?        @map("expiry_reminder_sent_at") @db.Timestamptz(6)
  acceptedUserId            String?          @map("accepted_user_id") @db.Uuid
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  acceptedAt                DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt                 DateTime?        @map("revoked_at") @db.Timestamptz(6)
  network                   Network          @relation(fields: [networkId], references: [id])

  @@index([emailLookup])
  @@map("invitations")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    Bytes     @unique @map("token_hash")
  userAgent    String    @map("user_agent")
  ip           String    @db.Inet
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt   DateTime  @map("last_seen_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  mfaSatisfied Boolean   @default(false) @map("mfa_satisfied")
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  Bytes     @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

model AuthThrottle {
  id              String    @id @default(uuid()) @db.Uuid
  identifierHash  Bytes     @unique @map("identifier_hash")
  failedCount     Int       @default(0) @map("failed_count")
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(6)
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(6)

  @@map("auth_throttle")
}

model AuditLog {
  id           BigInt        @id @default(autoincrement())
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  actorUserId  String?       @map("actor_user_id") @db.Uuid
  actorRole    String        @map("actor_role")
  action       String
  entityType   String?       @map("entity_type")
  entityId     String?       @map("entity_id")
  targetUserId String?       @map("target_user_id") @db.Uuid
  ip           String        @db.Inet
  userAgent    String        @map("user_agent")
  metadata     Json          @default("{}")
  severity     AuditSeverity

  @@index([createdAt])
  @@map("audit_log")
}

model Resource {
  id                  String    @id @default(uuid()) @db.Uuid
  title               String
  previewText         String    @map("preview_text")
  thumbnailObjectKey  String    @map("thumbnail_object_key")
  sourceLabel         String    @map("source_label")
  tags                String[]
  fileObjectKey       String    @map("file_object_key")
  fileSizeBytes       BigInt    @map("file_size_bytes")
  fileMimeType        String    @map("file_mime_type")
  visibility          String[]
  downloadCount       Int       @default(0) @map("download_count")
  uploadedBy          String    @map("uploaded_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([visibility], type: Gin)
  @@map("resources")
}

model Announcement {
  id                 String    @id @default(uuid()) @db.Uuid
  headline           String
  body               String
  ctaPrimaryLabel    String?   @map("cta_primary_label")
  ctaPrimaryUrl      String?   @map("cta_primary_url")
  ctaSecondaryLabel  String?   @map("cta_secondary_label")
  ctaSecondaryUrl    String?   @map("cta_secondary_url")
  activatesAt        DateTime  @map("activates_at") @db.Timestamptz(6)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  visibility         String[]
  dismissible        Boolean   @default(true)
  createdBy          String    @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  dismissals         AnnouncementDismissal[]
  impressions        AnnouncementImpression[]
  ctaClicks          AnnouncementCtaClick[]

  @@index([visibility], type: Gin)
  @@index([activatesAt])
  @@map("announcements")
}

model AnnouncementDismissal {
  userId         String       @map("user_id") @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  dismissedAt    DateTime     @map("dismissed_at") @db.Timestamptz(6)
  announcement   Announcement @relation(fields: [announcementId], references: [id])

  @@id([userId, announcementId])
  @@map("announcement_dismissals")
}

model AnnouncementImpression {
  userId         String       @map("user_id") @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  announcement   Announcement @relation(fields: [announcementId], references: [id])

  @@id([userId, announcementId])
  @@map("announcement_impressions")
}

model AnnouncementCtaClick {
  userId         String       @map("user_id") @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  slot           String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  announcement   Announcement @relation(fields: [announcementId], references: [id])

  @@id([userId, announcementId])
  @@map("announcement_cta_clicks")
}

model Event {
  id           String    @id @default(uuid()) @db.Uuid
  lockKey      BigInt    @unique @default(autoincrement()) @map("lock_key")
  title        String
  description  String
  startsAt     DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime  @map("ends_at") @db.Timestamptz(6)
  timezoneHint String?   @map("timezone_hint")
  location     String?
  isVirtual    Boolean   @map("is_virtual")
  capacity     Int?
  visibility   String[]
  hostUserId   String?   @map("host_user_id") @db.Uuid
  createdBy    String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  joinLink     EventJoinLink?
  rsvps        EventRsvp[]

  @@index([visibility], type: Gin)
  @@index([startsAt])
  @@map("events")
}

model EventJoinLink {
  eventId String @id @map("event_id") @db.Uuid
  url     String
  event   Event  @relation(fields: [eventId], references: [id])

  @@map("event_join_links")
}

model EventRsvp {
  userId          String    @map("user_id") @db.Uuid
  eventId         String    @map("event_id") @db.Uuid
  status          String
  waitlistedAt    DateTime? @map("waitlisted_at") @db.Timestamptz(6)
  reminderSentAt  DateTime? @map("reminder_sent_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  event           Event     @relation(fields: [eventId], references: [id])

  @@id([userId, eventId])
  @@map("event_rsvps")
}

model VisibilityRecord {
  id         String   @id @default(uuid()) @db.Uuid
  title      String
  visibility String[]
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([visibility], type: Gin)
  @@map("visibility_records")
}
