generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_MIGRATE")
}

enum ProgramRole {
  pathways
  lead
  none
}

enum AdminRole {
  super_admin
  admin
  moderator
  none
}

enum UserStatus {
  pending
  active
  deactivated
  denied
}

enum AuditSeverity {
  info
  warning
  security
}

enum JoinSource {
  self_registered
  invited
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

model Network {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  programRole ProgramRole  @map("program_role")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  users       User[]
  invitations Invitation[]

  @@map("networks")
}

model DocAffiliation {
  id        String   @id @default(uuid()) @db.Uuid
  label     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  @@map("doc_affiliations")
}

model User {
  id                        String               @id @default(uuid()) @db.Uuid
  emailLookup               Bytes                @unique @map("email_lookup")
  emailEncrypted            Bytes                @map("email_encrypted")
  passwordHash              String               @map("password_hash")
  firstNameEncrypted        Bytes?               @map("first_name_encrypted")
  lastNameEncrypted         Bytes?               @map("last_name_encrypted")
  titleEncrypted            Bytes?               @map("title_encrypted")
  docAffiliationIdEncrypted Bytes?               @map("doc_affiliation_id_encrypted")
  joinSource                JoinSource?          @map("join_source")
  registrationIp            String?              @map("registration_ip") @db.Inet
  denialReasonEncrypted     Bytes?               @map("denial_reason_encrypted")
  networkId                 String?              @map("network_id") @db.Uuid
  programRole               ProgramRole          @map("program_role")
  adminRole                 AdminRole            @map("admin_role")
  status                    UserStatus
  mfaSecretEncrypted        Bytes?               @map("mfa_secret_encrypted")
  mfaEnabled                Boolean              @default(false) @map("mfa_enabled")
  lastLoginAt               DateTime?            @map("last_login_at") @db.Timestamptz(6)
  createdAt                 DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  network                   Network?             @relation(fields: [networkId], references: [id])
  sessions                  Session[]
  passwordResetTokens       PasswordResetToken[]

  @@map("users")
}

model Invitation {
  id                        String           @id @default(uuid()) @db.Uuid
  emailLookup               Bytes            @map("email_lookup")
  emailEncrypted            Bytes            @map("email_encrypted")
  tokenHash                 Bytes            @unique @map("token_hash")
  inviterId                 String           @map("inviter_id") @db.Uuid
  networkId                 String           @map("network_id") @db.Uuid
  firstNameEncrypted        Bytes            @map("first_name_encrypted")
  lastNameEncrypted         Bytes            @map("last_name_encrypted")
  titleEncrypted            Bytes?           @map("title_encrypted")
  docAffiliationIdEncrypted Bytes?           @map("doc_affiliation_id_encrypted")
  status                    InvitationStatus
  expiresAt                 DateTime         @map("expires_at") @db.Timestamptz(6)
  expiryReminderSentAt      DateTime?        @map("expiry_reminder_sent_at") @db.Timestamptz(6)
  acceptedUserId            String?          @map("accepted_user_id") @db.Uuid
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  acceptedAt                DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt                 DateTime?        @map("revoked_at") @db.Timestamptz(6)
  network                   Network          @relation(fields: [networkId], references: [id])

  @@index([emailLookup])
  @@map("invitations")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    Bytes     @unique @map("token_hash")
  userAgent    String    @map("user_agent")
  ip           String    @db.Inet
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt   DateTime  @map("last_seen_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  mfaSatisfied Boolean   @default(false) @map("mfa_satisfied")
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  Bytes     @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

model AuthThrottle {
  id              String    @id @default(uuid()) @db.Uuid
  identifierHash  Bytes     @unique @map("identifier_hash")
  failedCount     Int       @default(0) @map("failed_count")
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(6)
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(6)

  @@map("auth_throttle")
}

model AuditLog {
  id           BigInt        @id @default(autoincrement())
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  actorUserId  String?       @map("actor_user_id") @db.Uuid
  actorRole    String        @map("actor_role")
  action       String
  entityType   String?       @map("entity_type")
  entityId     String?       @map("entity_id")
  targetUserId String?       @map("target_user_id") @db.Uuid
  ip           String        @db.Inet
  userAgent    String        @map("user_agent")
  metadata     Json          @default("{}")
  severity     AuditSeverity

  @@index([createdAt])
  @@map("audit_log")
}

model VisibilityRecord {
  id         String   @id @default(uuid()) @db.Uuid
  title      String
  visibility String[]
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([visibility], type: Gin)
  @@map("visibility_records")
}
